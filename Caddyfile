{$DOMAIN} {
	encode gzip

	# same-origin с web — CORS между панелью и API не нужен вообще
	handle /api/* {
		reverse_proxy api:4000
	}

	# Live-обновления «Заявок» (Socket.IO, apps/api/src/lib/realtime.ts) — тот же
	# api-контейнер, отдельный path вместо /api/*, т.к. это не REST. Caddy сам
	# проксирует заголовки Connection/Upgrade для WebSocket, отдельно включать не нужно.
	handle /socket.io/* {
		reverse_proxy api:4000
	}

	# Presigned-ссылки на вложения (см. apps/api/src/lib/storage.ts) подписываются
	# публичным адресом — MinIO сам наружу не выставлен (только внутри docker-сети),
	# поэтому запросы на путь бакета проксируются сюда как есть, БЕЗ обрезки
	# префикса: подпись SigV4 учитывает путь запроса, а бакет — уже первый сегмент
	# пути при path-style S3 (forcePathStyle=true), так что пути совпадают 1-в-1.
	handle /{$S3_BUCKET}/* {
		reverse_proxy minio:9000
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
