# Скопируйте в .env и заполните перед запуском

NODE_ENV=development

# --- Postgres ---
POSTGRES_USER=hotline
POSTGRES_PASSWORD=hotline
POSTGRES_DB=hotline
DATABASE_URL=postgresql://hotline:hotline@localhost:5434/hotline?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6380

# --- Backend API ---
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Внутренний токен, которым боты авторизуются к API (не для веб-клиентов)
BOT_SERVICE_TOKEN=change-me-bot-service-token

# --- Object storage (MinIO, S3-совместимый) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hotline-attachments
S3_ACCESS_KEY=hotline
S3_SECRET_KEY=hotline12345
S3_FORCE_PATH_STYLE=true

# --- Telegram-бот сотрудников (apps/bot-employee) ---
TELEGRAM_BOT_TOKEN=
BOT_API_BASE_URL=http://localhost:4000/api/v1
# Общий/производственный чаты — при увольнении (исход "Уволить" на заявлении на
# увольнение) бот удаляет сотрудника из них. Бот должен быть заранее добавлен в
# оба чата и назначен администратором с правом "Блокировка пользователей".
TERMINATION_REMOVAL_CHAT_IDS=-1003386177772,-1003674354103

# --- Telegram-бот клиентов (apps/bot-customer, Фаза 7) — отдельный токен, получить
# у @BotFather для нового бота, BOT_API_BASE_URL/BOT_SERVICE_TOKEN общие с bot-employee ---
TELEGRAM_CUSTOMER_BOT_TOKEN=

# --- Sentry (опционально; при пустом DSN — no-op) ---
SENTRY_DSN=

# --- Web Push (опционально; при пустых ключах — уведомления только в разделе "Уведомления") ---
# Сгенерировать: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- «Заявки»: email-лиды с sales@lemarkllc.ru через robot@ (Zimbra, mail.lemarkllc.ru) ---
EMAIL_IMAP_HOST=mail.lemarkllc.ru
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=robot@lemarkllc.ru
EMAIL_IMAP_PASSWORD=
EMAIL_SMTP_HOST=mail.lemarkllc.ru
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=robot@lemarkllc.ru
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=robot@lemarkllc.ru
EMAIL_POLL_INTERVAL_MS=60000

# --- Bitrix24: входящий вебхук (Настройки → Разработчикам → Входящий вебхук, права crm+user) ---
BITRIX_WEBHOOK_URL=

# --- Web ---
WEB_PORT=5183
VITE_API_BASE_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:5183
