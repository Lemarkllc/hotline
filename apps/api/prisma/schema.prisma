// HotLineBot — модель данных (SRS §19, PLAN.md §3 и §6)
//
// Правила: UUID PK, все даты в UTC, soft delete (deletedAt) — физическое удаление
// обращений запрещено (FR-APP-014). `channel` заложен с первого дня, чтобы канал
// CUSTOMER (Фаза 7, PLAN.md §6) не потребовал миграции данных задним числом.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  EMPLOYEE
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  BLOCKED
  ARCHIVED
}

enum AppealMode {
  OPEN
  CONFIDENTIAL
}

enum AppealStatus {
  OPEN
  UNDER_REVIEW
  IN_PROGRESS
  CLOSED
}

/// Исход закрытия заявления на увольнение (type="RESIGNATION", EMPLOYEE) — не общий
/// статус, живёт рядом с AppealStatus.CLOSED, не вместо него. См. Appeal.resignationOutcome.
enum ResignationOutcome {
  TERMINATED
  WITHDRAWN
}

enum CommentVisibility {
  INTERNAL
  PUBLIC
}

enum NotificationChannel {
  TELEGRAM
  WEB
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AttachmentKind {
  PHOTO
  VIDEO
}

/// Роли — фиксированный набор (EMPLOYEE/MANAGER/ADMINISTRATOR/HRD), но права
/// хранятся как отдельные строки в RolePermission, а не enum'ом — соответствует
/// явному списку permission-строк из SRS §21.
model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  userRoles   UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model RolePermission {
  id         String @id @default(uuid())
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@map("role_permissions")
}

/// Внутренний пользователь (сотрудник). Одна и та же таблица покрывает и
/// Telegram-идентификацию (FR-AUTH-001), и веб-аккаунты HRD/менеджеров/админов
/// (SRS §4.1: "для Web панели регистрация отдельная") — телефон/пароль просто
/// не заполнены у обычного сотрудника, который есть только в боте.
model User {
  id         String     @id @default(uuid())
  telegramId BigInt?    @unique
  fullName   String
  status     UserStatus @default(PENDING)

  email              String?   @unique
  passwordHash       String?
  mustChangePassword Boolean   @default(false)
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  privacyAcceptedAt  DateTime?
  blockReason        String?

  /// Дата приёма на работу — источник для формулы остатка отпуска (PLAN.md §10,
  /// 2.33 дня/месяц с даты приёма). Nullable — не заведена для всех сразу, вводится
  /// вручную HRD/Администратором (UsersPage) до появления полноценного бот-онбординга.
  hireDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userRoles                   UserRole[]
  channelAccess               UserChannelAccess[]
  createdAppeals              Appeal[]              @relation("AppealAuthor")
  assignments                 AppealAssignment[]    @relation("AssignedUser")
  comments                    AppealComment[]
  sentMessages                AppealMessage[]       @relation("MessageAuthor")
  statusChanges               AppealStatusHistory[] @relation("ChangedBy")
  ratings                     Rating[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  accessRequest               AccessRequest?
  decidedAccessRequests       AccessRequest[]       @relation("DecidedBy")
  pushSubscriptions           PushSubscription[]
  sentLeadMessages            EmailLeadMessage[]    @relation("LeadMessageSentBy")
  vacationRequests            VacationRequest[]     @relation("VacationAuthor")
  decidedVacationRequests     VacationRequest[]     @relation("VacationDecidedBy")
  processedVacationRequests   VacationRequest[]     @relation("VacationProcessedBy")
  absenceRequests             AbsenceRequest[]      @relation("AbsenceAuthor")
  decidedAbsenceRequests      AbsenceRequest[]      @relation("AbsenceDecidedBy")
  businessTripRequests        BusinessTripRequest[] @relation("BusinessTripAuthor")
  decidedBusinessTripRequests BusinessTripRequest[] @relation("BusinessTripDecidedBy")
  processedAppeals            Appeal[]              @relation("AppealProcessedBy")
  vacationBalance             VacationBalance?

  @@index([status])
  @@map("users")
}

/// Стартовый остаток отпуска на конкретную дату (PLAN.md §10) — разовый снепшот из
/// кадровых данных заказчика, не поле, которое кто-то регулярно правит построчно.
/// Баланс "на сегодня" считается формулой (User.hireDate + это + одобренные отпуска
/// после asOfDate), а не хранится готовым числом — см. utils/vacationBalance.ts.
model VacationBalance {
  userId          String   @id
  startingBalance Float
  asOfDate        DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vacation_balances")
}

/// Веб-push подписка браузера (Web Push API). Один пользователь может иметь несколько
/// подписок (разные браузеры/устройства) — endpoint уникален и служит естественным ключом.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

/// Доступ к каналу — отдельно от роли (PLAN.md §6). Permission из роли действует
/// только в каналах, на которые у пользователя есть грант здесь.
model UserChannelAccess {
  id        String   @id @default(uuid())
  userId    String
  channel   Channel
  grantedBy String?
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("user_channel_access")
}

/// Заявка на подтверждение сотрудника администратором (SRS §5, FR-USR-001..003).
model AccessRequest {
  id             String     @id @default(uuid())
  userId         String     @unique
  telegramId     BigInt
  fullName       String
  status         UserStatus @default(PENDING)
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?
  createdAt      DateTime   @default(now())

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("DecidedBy", fields: [decidedById], references: [id])

  @@map("access_requests")
}

/// Внешний контакт (клиент) — канал CUSTOMER, Фаза 7. Заведено уже сейчас, чтобы
/// Appeal.externalContactId существовал в схеме с первого дня (PLAN.md §6).
/// Без approval-флоу access_requests — вместо него обязательное согласие на
/// обработку персональных данных (consentAt/consentVersion).
model ExternalContact {
  id             String    @id @default(uuid())
  telegramId     BigInt    @unique
  fullName       String?
  phone          String?
  orderNumber    String?
  consentAt      DateTime?
  consentVersion String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  appeals       Appeal[]
  ratings       Rating[]
  notifications Notification[]

  @@map("external_contacts")
}

/// Справочник эпиков — раздельный per channel (PLAN.md §6): у сотрудников и
/// клиентов разные тематические списки, один и тот же механизм администрирования.
model Epic {
  id        String   @id @default(uuid())
  channel   Channel  @default(EMPLOYEE)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appeals Appeal[]

  @@unique([channel, name])
  @@map("epics")
}

model Appeal {
  id           String  @id @default(uuid())
  publicNumber String  @unique
  channel      Channel @default(EMPLOYEE)

  /// Строка, а не Postgres enum — намеренно: канал CUSTOMER получит свой
  /// набор типов отдельным справочником (PLAN.md §6), без миграции колонки.
  /// Для канала EMPLOYEE валидируется Zod-схемой из @hotline/shared (EMPLOYEE_APPEAL_TYPES).
  type   String
  mode   AppealMode
  status AppealStatus @default(OPEN)

  authorUserId      String?
  externalContactId String?
  epicId            String?

  originalText String
  workingEdit  String?

  /// Только для type="RESIGNATION" (EMPLOYEE) — заполняется при закрытии, определяет
  /// исход (реально уволен / отозвал заявление). null для всех остальных типов и пока
  /// заявление на увольнение не закрыто. Сбрасывается в null при реоткрытии — исход
  /// больше не финальный.
  resignationOutcome ResignationOutcome?

  /// Стадия «Оформление» (только type="RESIGNATION", resignationOutcome="TERMINATED") —
  /// чек-лист HR перед фактическим исполнением увольнения. Осознанно НЕ завязано на
  /// status/resignationOutcome (см. VacationRequest.processedAt — тот же принцип):
  /// исполнение (блокировка + удаление из чатов, userService.blockUser) теперь
  /// срабатывает не сразу при закрытии обращения, а отложено до processedAt — клика
  /// HR «Оформить», когда отмечены все четыре пункта ниже (прямое решение пользователя).
  walkoffSheetSigned           Boolean   @default(false)
  terminationOrderSigned       Boolean   @default(false)
  certificatesIssued           Boolean   @default(false)
  terminationApplicationSigned Boolean   @default(false)
  processedById                String?
  processedAt                  DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  closedAt         DateTime?
  deletedAt        DateTime?
  reopenDeadlineAt DateTime?

  author          User?            @relation("AppealAuthor", fields: [authorUserId], references: [id])
  externalContact ExternalContact? @relation(fields: [externalContactId], references: [id])
  epic            Epic?            @relation(fields: [epicId], references: [id])
  processedBy     User?            @relation("AppealProcessedBy", fields: [processedById], references: [id])

  assignments   AppealAssignment[]
  comments      AppealComment[]
  messages      AppealMessage[]
  attachments   AppealAttachment[]
  statusHistory AppealStatusHistory[]
  rating        Rating?
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([channel])
  @@index([createdAt])
  @@index([epicId])
  @@index([authorUserId])
  @@map("appeals")
}

model AppealAssignment {
  id           String    @id @default(uuid())
  appealId     String
  userId       String
  isPrimary    Boolean   @default(true)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  user   User   @relation("AssignedUser", fields: [userId], references: [id])

  @@index([appealId])
  @@index([userId])
  @@map("appeal_assignments")
}

/// Внутренние (HRD/менеджер) и пользовательские (PUBLIC) комментарии — разделены
/// полем visibility (FR-COM-001/002): PUBLIC-комментарий уходит автору как AppealMessage,
/// здесь же остаётся как запись для карточки.
model AppealComment {
  id            String            @id @default(uuid())
  appealId      String
  authorId      String
  visibility    CommentVisibility
  text          String
  isFinalAnswer Boolean           @default(false)
  createdAt     DateTime          @default(now())
  editedAt      DateTime?
  deletedAt     DateTime?

  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([appealId])
  @@map("appeal_comments")
}

/// Переписка с автором через бота (SRS §4.4 сценарий "Запросить уточнение").
model AppealMessage {
  id        String   @id @default(uuid())
  appealId  String
  fromHrd   Boolean
  /// Кто из персонала отправил (fromHrd=true) — не только HRD, несмотря на имя поля
  /// (общий пул: HRD/менеджер/«Продажи», любой с правом писать в это обращение).
  /// null при fromHrd=false — отправитель тогда сам автор обращения, уже известен
  /// через appeal.author/externalContact, дублировать незачем.
  authorId  String?
  text      String
  createdAt DateTime @default(now())

  appeal Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  author User?  @relation("MessageAuthor", fields: [authorId], references: [id])

  @@index([appealId])
  @@map("appeal_messages")
}

/// Загружается ботом ДО создания обращения (черновик) — appealId проставляется
/// при отправке (FR-DRF-006: вложения черновика удаляются по истечении срока,
/// поэтому uploadedByUserId/draftExpiresAt нужны независимо от appealId).
model AppealAttachment {
  id               String         @id @default(uuid())
  appealId         String?
  /// Параллельно appealId — то же самое nullable-FK-после-драфта решение, но для
  /// заявки на отпуск (фото заявления, обязательное вложение — прямое решение
  /// пользователя). Ровно одно из двух (appealId/vacationRequestId) заполнено на
  /// строку, никогда оба сразу.
  vacationRequestId String?
  uploadedByUserId String?
  storageKey       String
  mimeType         String
  fileSize         Int
  kind             AttachmentKind
  createdAt        DateTime       @default(now())
  draftExpiresAt   DateTime?
  deletedAt        DateTime?

  appeal          Appeal?          @relation(fields: [appealId], references: [id], onDelete: Cascade)
  vacationRequest VacationRequest? @relation(fields: [vacationRequestId], references: [id], onDelete: Cascade)

  @@index([appealId])
  @@index([vacationRequestId])
  @@index([uploadedByUserId])
  @@index([draftExpiresAt])
  @@map("appeal_attachments")
}

/// Append-only история статусов (FR-WF-008) — строки никогда не изменяются и не удаляются.
model AppealStatusHistory {
  id          String        @id @default(uuid())
  appealId    String
  fromStatus  AppealStatus?
  toStatus    AppealStatus
  changedById String?
  reason      String?
  createdAt   DateTime      @default(now())

  appeal    Appeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("ChangedBy", fields: [changedById], references: [id])

  @@index([appealId])
  @@map("appeal_status_history")
}

/// Автор оценки — union User/ExternalContact, тем же паттерном, что и Appeal.author
/// (Фаза 7, PLAN.md §6): для EMPLOYEE заполнен authorId, для CUSTOMER — externalContactId.
model Rating {
  id       String @id @default(uuid())
  appealId String @unique

  authorId          String?
  externalContactId String?

  /// EMPLOYEE: "насколько результат решил вопрос" (FR-EVL-001..005). Не используется
  /// для CUSTOMER — там вместо одного числа два отдельных ниже (Фаза 7, PLAN.md §6).
  score   Int?
  comment String?

  /// CUSTOMER-only, оба обязательны при закрытии обращения в канале CUSTOMER
  /// (NPS-style: "порекомендовали бы" / "обратитесь ли снова"). Null для EMPLOYEE.
  wouldRecommendScore Int?
  wouldReturnScore    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appeal          Appeal           @relation(fields: [appealId], references: [id], onDelete: Cascade)
  author          User?            @relation(fields: [authorId], references: [id])
  externalContact ExternalContact? @relation(fields: [externalContactId], references: [id])

  @@map("ratings")
}

model Notification {
  id                String              @id @default(uuid())
  userId            String?
  /// Получатель в канале CUSTOMER — эквивалент userId для ExternalContact (Фаза 7,
  /// PLAN.md §6): бот клиентов резолвит telegramId через эту связь, не через user.
  externalContactId String?
  appealId          String?
  /// «Заявки» (EmailLead) — независимая от Appeal подсистема (см. PLAN.md), поэтому
  /// отдельная колонка, а не переиспользование appealId. Ровно одно из appealId/
  /// emailLeadId заполнено на строку, либо оба пусты (см. notifyEmployeeTerminated).
  emailLeadId       String?
  channel           NotificationChannel
  status            NotificationStatus  @default(PENDING)
  payload           Json
  attempts          Int                 @default(0)
  lastError         String?
  createdAt         DateTime            @default(now())
  sentAt            DateTime?

  user            User?            @relation(fields: [userId], references: [id])
  externalContact ExternalContact? @relation(fields: [externalContactId], references: [id])
  appeal          Appeal?          @relation(fields: [appealId], references: [id])
  emailLead       EmailLead?       @relation(fields: [emailLeadId], references: [id])

  @@index([status])
  @@map("notifications")
}

/// Append-only на уровне приложения (SRS §37) — сервисный слой не предоставляет update/delete.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  objectType String
  objectId   String?
  appealId   String?
  requestId  String?
  ipAddress  String?
  userAgent  String?
  result     String
  metadata   Json?
  reason     String?
  createdAt  DateTime @default(now())

  actor  User?   @relation(fields: [actorId], references: [id])
  appeal Appeal? @relation(fields: [appealId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// Атомарный счётчик для генерации publicNumber (ключ вида "EMPLOYEE:2026").
/// Отдельная модель вместо подсчёта строк appeals — подсчёт по COUNT() гонится
/// при конкурентной записи и ломается на soft-deleted строках.
model NumberSequence {
  key   String @id
  value Int    @default(0)

  @@map("number_sequences")
}

/// «Заявки» — email-лиды с sales@lemarkllc.ru (читаются через robot@ на Zimbra),
/// полностью отдельная от Appeal/ExternalContact/CUSTOMER-канала подсистема
/// (см. PLAN.md "«Заявки» — email-лиды..." — намеренное архитектурное решение,
/// не расширение канала CUSTOMER).
enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  STOP_LISTED
}

/// OUTBOUND — ответ сотрудника с sales@ (leadService.reply), не письмо от клиента.
/// Появилось вместе с assigneeId/SLA-таймером — до этого EmailLeadMessage хранил
/// только входящие письма (design_handoff_lemark_one/Leads.dc.html предполагает
/// композер ответа прямо из карточки).
enum EmailLeadMessageDirection {
  INBOUND
  OUTBOUND
}

model EmailLead {
  id           String @id @default(uuid())
  publicNumber String @unique

  fromEmail      String
  fromName       String?
  extractedPhone String?
  /// Второй email из тела письма (другое контактное лицо) — доп. канал связи,
  /// отличный от fromEmail (адреса отправителя).
  extractedEmail String?
  subject        String
  originalBody   String

  status LeadStatus @default(NEW)

  bitrixLeadId      String?
  convertedByUserId String?
  convertedAt       DateTime?

  /// Ответственный — не внутреннее назначение, а снимок Bitrix24-пользователя,
  /// выбранного в момент "Передать в CRM" (leadService.convertToCrm), тот же человек,
  /// что стал ASSIGNED_BY_ID в самом Bitrix. До конвертации у заявки нет ответственного
  /// вовсе — продажники работают в Bitrix, не в HotLine (решение пользователя: не
  /// заводить отдельное внутреннее назначение и связь HotLine-юзер↔Bitrix-юзер ради
  /// уведомления, которое всё равно никто не увидит). Денормализованный кэш имени/email,
  /// не FK — тем же принципом, что и bitrixLeadId выше, нет локальной таблицы Bitrix-
  /// пользователей.
  bitrixAssigneeId    String?
  bitrixAssigneeName  String?
  bitrixAssigneeEmail String?

  /// Денормализованная копия PickedAssignee.reason (leadAssignmentService.ts) — до этого
  /// была видна только в audit_log (action=lead.auto_converted, metadata.reason), что
  /// заставляло лазить в БД руками при вопросе "почему всё ушло Роме". null при ручной
  /// convertToCrm — reason существует только у алгоритмического выбора.
  autoAssignReason String?

  stopListedByUserId String?
  stopListedAt       DateTime?
  stopListReason     String?

  /// Автоответ клиенту шлётся только при создании НОВОЙ заявки (не на письма,
  /// доливаемые в уже открытую) — см. PLAN.md, решение №7.
  confirmationEmailSentAt DateTime?
  confirmationEmailError  String?

  /// Режим наблюдения (leadAiService) — ИИ пишет вердикт релевантности сюда, но
  /// поведение системы (кому уходит отбивка, статус) пока НЕ меняется. Только на
  /// НОВЫХ заявках (первое сообщение), не на доливаемых письмах в открытый тред.
  aiProcessedAt DateTime?
  aiIsRelevant  Boolean?
  aiReasoning   String?
  aiError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      EmailLeadMessage[]
  notifications Notification[]

  @@index([fromEmail, status])
  @@map("email_leads")
}

/// Полный тред писем по заявке, включая самое первое (originalBody/subject на
/// EmailLead — денормализованная копия первого сообщения для быстрого списка).
model EmailLeadMessage {
  id          String    @id @default(uuid())
  emailLeadId String
  emailLead   EmailLead @relation(fields: [emailLeadId], references: [id])

  fromEmail  String
  subject    String
  body       String
  receivedAt DateTime

  direction    EmailLeadMessageDirection @default(INBOUND)
  /// Заполнен только у OUTBOUND (кто ответил с sales@) — для подписи в треде
  /// («имя · время · доставлено», design_handoff_lemark_one/Leads.dc.html).
  sentByUserId String?
  sentBy       User?                     @relation("LeadMessageSentBy", fields: [sentByUserId], references: [id])

  createdAt DateTime @default(now())

  attachments EmailLeadAttachment[]

  @@map("email_lead_messages")
}

/// Вложения из писем клиентов (не из бота — отдельное хранилище от AppealAttachment,
/// "Заявки" не связаны с Appeal, см. PLAN.md "«Заявки» — email-лиды...").
model EmailLeadAttachment {
  id                 String           @id @default(uuid())
  emailLeadMessageId String
  emailLeadMessage   EmailLeadMessage @relation(fields: [emailLeadMessageId], references: [id])

  filename   String
  mimeType   String
  fileSize   Int
  storageKey String

  createdAt DateTime @default(now())

  @@map("email_lead_attachments")
}

/// Адреса из "Заявка → В стоп-лист" — письма с этих адресов больше не создают
/// EmailLead вообще (тихо игнорируются на этапе разбора почты), см. emailIngestService.
model EmailBlocklistEntry {
  id     String  @id @default(uuid())
  email  String  @unique
  reason String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@map("email_blocklist_entries")
}

enum VacationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// «Отпуска» — самостоятельная сущность, не Appeal: сотрудник подаёт через бота,
/// согласовывает только HRD (прямое решение пользователя, не из SRS — см.
/// design_handoff_lemark_one/README.md "Отсутствия", модуль был явно отложен до
/// этого решения). userId НЕ unique (в отличие от AccessRequest) — у сотрудника
/// может быть много заявок за разное время.
model VacationRequest {
  id           String         @id @default(uuid())
  publicNumber String         @unique
  userId       String
  /// Продублирован с User.telegramId — тот же приём, что и у AccessRequest, бот
  /// может показать/подтвердить заявку без join.
  telegramId   BigInt
  dateFrom     DateTime
  dateTo       DateTime
  comment      String?
  /// true — оплачиваемый (списывается с баланса, PLAN.md §10), false — за свой счёт
  /// (без ограничения в коде). Добавлено вместе с формулой остатка отпуска.
  paid         Boolean        @default(true)
  status       VacationStatus @default(PENDING)

  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?

  /// Стадия «Оформление» (роль HR, право hr.process) — независимые от status поля:
  /// APPROVED уже участвует в расчёте остатка отпуска (sumApprovedPaidDaysSince), менять
  /// его при оформлении бумаг нельзя, поэтому прогресс — отдельно, а не новый статус.
  applicationDrafted Boolean   @default(false)
  applicationSigned  Boolean   @default(false)
  processedById      String?
  processedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation("VacationAuthor", fields: [userId], references: [id])
  decidedBy   User?              @relation("VacationDecidedBy", fields: [decidedById], references: [id])
  processedBy User?              @relation("VacationProcessedBy", fields: [processedById], references: [id])
  attachments AppealAttachment[]

  @@index([userId, status])
  @@map("vacation_requests")
}

/// «Отсутствие» (PLAN.md §10) — было типом обращения TIME_OFF ("Отпроситься"),
/// перенесено сюда после разговора с HRD: тот же формальный workflow
/// PENDING→APPROVED/REJECTED, что у VacationRequest/BusinessTripRequest, а не
/// статус-флоу обращений. fullDay=true — timeFrom/timeTo не заданы.
model AbsenceRequest {
  id           String         @id @default(uuid())
  publicNumber String         @unique
  userId       String
  telegramId   BigInt
  date         DateTime
  fullDay      Boolean
  timeFrom     String?
  timeTo       String?
  reason       String?
  status       VacationStatus @default(PENDING)

  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("AbsenceAuthor", fields: [userId], references: [id])
  decidedBy User? @relation("AbsenceDecidedBy", fields: [decidedById], references: [id])

  @@index([userId, status])
  @@map("absence_requests")
}

enum BusinessTripTransport {
  CAR
  PLANE
  TRAIN
  OTHER
}

/// «Командировка» (PLAN.md §10) — новая сущность, тот же workflow, что у Vacation/
/// Absence. purpose обязателен (HRD не может согласовывать вслепую), transportOther
/// заполняется только при transport=OTHER (валидируется в Zod, не в схеме БД).
model BusinessTripRequest {
  id             String                @id @default(uuid())
  publicNumber   String                @unique
  userId         String
  telegramId     BigInt
  dateFrom       DateTime
  dateTo         DateTime
  purpose        String
  transport      BusinessTripTransport
  transportOther String?
  hotelNeeded    Boolean
  status         VacationStatus        @default(PENDING)

  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User  @relation("BusinessTripAuthor", fields: [userId], references: [id])
  decidedBy User? @relation("BusinessTripDecidedBy", fields: [decidedById], references: [id])

  @@index([userId, status])
  @@map("business_trip_requests")
}
